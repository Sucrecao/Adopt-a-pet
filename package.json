{
  "name": "pawpal-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "可爱、自由活动的猫狗鹦鹉桌面伙伴",
  "author": "PawPal",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "test:ui": "playwright test",
    "test:desktop": "npm run build && node scripts/smoke-electron.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64 -c.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.pawpal.desktop",
    "productName": "PawPal",
    "icon": "public/icon.png",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "src/core/**/*", "package.json"],
    "asar": true,
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "hardenedRuntime": true
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
